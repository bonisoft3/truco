FROM busybox:musl@sha256:03db190ed4c1ceb1c55d179a0940e2d71d42130636a780272629735893292223 AS caddy_ctxs
WORKDIR /monorepo/.
COPY --parents docker/Caddyfile shell/index.html shell/shell.css shell/boot.js offline-first-sw.js shell/shell.yaml shell/shell.json shell/design.css shell/screens/arena.html shell/screens/arena.css shell/screens/regras.html shell/screens/regras.css shell/handlers/seats2.js shell/handlers/sitting.js shell/handlers/spun.js shell/handlers/stake0.js shell/handlers/table.js shell/handlers/variant2.js shell/handlers/variant3.js shell/shared/table.css messages/pt-BR.json messages/es-AR.json messages/es-UY.json messages/es-PY.json messages/ca-ES.json documents/ar/reglas/index.html documents/ca/regles/index.html documents/py/reglas/index.html documents/regras/index.html documents/uy/reglas/index.html shell/assets/bigode.png shell/assets/cida.png shell/assets/jordi.png shell/assets/nezinho.png shell/assets/osvaldo.png shell/assets/tabare.png shell/assets/tiao.png shell/assets/tiao_queijo.png shell/assets/xiru.png brief.html ir.html acceptance.md DESIGN.md robots.txt sitemap.xml ./
ARG SOURCE_DATE_EPOCH
ARG BAYT_CLAMP=1
RUN if [ "${BAYT_CLAMP:-1}" != 0 ]; then find /monorepo/. -exec touch -hd @${SOURCE_DATE_EPOCH:-0} {} + && touch -hd @${SOURCE_DATE_EPOCH:-0} /monorepo; fi
FROM scratch AS caddy_srcs
COPY --from=caddy_ctxs /monorepo /monorepo

