# generated from bayt.cue — do not edit
FROM libraries_mecha-database-image AS timer-check
ARG BAYT_DIR
WORKDIR /monorepo/${BAYT_DIR}
COPY .bayt/Taskfile.yml .bayt/Taskfile.bayt.yml .bayt/bayt.timer-check.json ./.bayt/
ENTRYPOINT ["psql"]
CMD ["-X", "--set=ON_ERROR_STOP=1", "--single-transaction", "--file=/timer-check.sql"]
COPY <<'TIMERS' /timer-check.sql
DO $$ BEGIN
  IF to_regprocedure('hybrid_truco_match.arm(uuid, bigint, jsonb, bigint)') IS NULL AND EXISTS (SELECT FROM hybrid_truco_match.instance i WHERE i.state->>'phase' = 'playing'
      AND NOT EXISTS (SELECT FROM public.schedule s WHERE s.emits_entity = 'machine_timer_tick'
        AND s.emits_values @> jsonb_build_object('machine', 'truco_match', 'row', jsonb_build_object('id', i.id::text), 'state', 'playing', 'delay', 'turn'))) THEN
    RAISE EXCEPTION 'machine truco_match has instances in playing whose turn timer the ticker was never given';
  END IF;
END $$;
DO $$ BEGIN
  IF to_regprocedure('hybrid_truco_match.arm(uuid, bigint, jsonb, bigint)') IS NULL AND EXISTS (SELECT FROM hybrid_truco_match.instance i WHERE i.state->>'phase' = 'wager'
      AND NOT EXISTS (SELECT FROM public.schedule s WHERE s.emits_entity = 'machine_timer_tick'
        AND s.emits_values @> jsonb_build_object('machine', 'truco_match', 'row', jsonb_build_object('id', i.id::text), 'state', 'wager', 'delay', 'turn'))) THEN
    RAISE EXCEPTION 'machine truco_match has instances in wager whose turn timer the ticker was never given';
  END IF;
END $$;
DO $$ BEGIN
  IF to_regprocedure('hybrid_truco_match.arm(uuid, bigint, jsonb, bigint)') IS NULL AND EXISTS (SELECT FROM hybrid_truco_match.instance i WHERE i.state->>'phase' = 'brink'
      AND NOT EXISTS (SELECT FROM public.schedule s WHERE s.emits_entity = 'machine_timer_tick'
        AND s.emits_values @> jsonb_build_object('machine', 'truco_match', 'row', jsonb_build_object('id', i.id::text), 'state', 'brink', 'delay', 'turn'))) THEN
    RAISE EXCEPTION 'machine truco_match has instances in brink whose turn timer the ticker was never given';
  END IF;
END $$;
DO $$ BEGIN
  IF to_regprocedure('hybrid_truco_match.arm(uuid, bigint, jsonb, bigint)') IS NULL AND EXISTS (SELECT FROM hybrid_truco_match.instance i WHERE i.state->>'phase' = 'envido'
      AND NOT EXISTS (SELECT FROM public.schedule s WHERE s.emits_entity = 'machine_timer_tick'
        AND s.emits_values @> jsonb_build_object('machine', 'truco_match', 'row', jsonb_build_object('id', i.id::text), 'state', 'envido', 'delay', 'turn'))) THEN
    RAISE EXCEPTION 'machine truco_match has instances in envido whose turn timer the ticker was never given';
  END IF;
END $$;
DO $$ BEGIN
  IF to_regprocedure('hybrid_truco_presence.arm(uuid, bigint, jsonb, bigint)') IS NULL AND EXISTS (SELECT FROM hybrid_truco_presence.instance i WHERE i.state->>'phase' = 'visible'
      AND NOT EXISTS (SELECT FROM public.schedule s WHERE s.emits_entity = 'machine_timer_tick'
        AND s.emits_values @> jsonb_build_object('machine', 'truco_presence', 'row', jsonb_build_object('id', i.id::text), 'state', 'visible', 'delay', '30000'))) THEN
    RAISE EXCEPTION 'machine truco_presence has instances in visible whose 30000 timer the ticker was never given';
  END IF;
END $$;
DO $$ BEGIN
  IF to_regprocedure('hybrid_truco_challenge.arm(uuid, bigint, jsonb, bigint)') IS NULL AND EXISTS (SELECT FROM hybrid_truco_challenge.instance i WHERE i.state->>'phase' = 'offered'
      AND NOT EXISTS (SELECT FROM public.schedule s WHERE s.emits_entity = 'machine_timer_tick'
        AND s.emits_values @> jsonb_build_object('machine', 'truco_challenge', 'row', jsonb_build_object('id', i.id::text), 'state', 'offered', 'delay', '30000'))) THEN
    RAISE EXCEPTION 'machine truco_challenge has instances in offered whose 30000 timer the ticker was never given';
  END IF;
END $$;
DO $$ BEGIN
  IF to_regprocedure('hybrid_truco_call.arm(uuid, bigint, jsonb, bigint)') IS NULL AND EXISTS (SELECT FROM hybrid_truco_call.instance i WHERE i.state->>'phase' = 'offered'
      AND NOT EXISTS (SELECT FROM public.schedule s WHERE s.emits_entity = 'machine_timer_tick'
        AND s.emits_values @> jsonb_build_object('machine', 'truco_call', 'row', jsonb_build_object('id', i.id::text), 'state', 'offered', 'delay', '30000'))) THEN
    RAISE EXCEPTION 'machine truco_call has instances in offered whose 30000 timer the ticker was never given';
  END IF;
END $$;
TIMERS

FROM busybox:musl@sha256:03db190ed4c1ceb1c55d179a0940e2d71d42130636a780272629735893292223 AS timer-check_bayt_ctxs
ARG BAYT_DIR
WORKDIR /monorepo/${BAYT_DIR}
COPY --parents .bayt/compose.timer-check.yaml .bayt/Dockerfile.timer-check .bayt/bayt.timer-check.json .bayt/Taskfile.yml .bayt/Taskfile.bayt.yml .bayt/process-compose.yaml ./
COPY --from=truco-database_bayt /monorepo /monorepo
COPY --from=truco-migrate_bayt /monorepo /monorepo
ARG SOURCE_DATE_EPOCH
ARG BAYT_CLAMP=1
RUN if [ "${BAYT_CLAMP:-1}" != 0 ]; then { w=$(pwd); mkdir -p /.bayt-clamp && find "$w" -exec getfattr -dh {} + > /.bayt-clamp/x && if [ ! -s /.bayt-clamp/x ]; then cd / && cp -a "$w" /.bayt-clamp/w && rm -rf "$w" && mv /.bayt-clamp/w "$w"; fi && rm -rf /.bayt-clamp; } && find /monorepo/${BAYT_DIR} -exec touch -hd @${SOURCE_DATE_EPOCH:-0} {} + && { d=$(dirname /monorepo/${BAYT_DIR}); while [ "$d" != / ]; do touch -hd @${SOURCE_DATE_EPOCH:-0} "$d" || exit; d=$(dirname "$d"); done; }; fi
FROM scratch AS timer-check_bayt
COPY --from=timer-check_bayt_ctxs /monorepo /monorepo
