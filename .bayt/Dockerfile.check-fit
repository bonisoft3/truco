FROM truco-browser AS check-fit
WORKDIR /monorepo/.
COPY --from=plugins_omnishell-runtime-image / /omnishell
COPY --parents tests/** ./
COPY .bayt/Taskfile.yml .bayt/Taskfile.bayt.yml .bayt/Taskfile.check-fit.yaml .bayt/bayt.check-fit.json ./.bayt/

FROM busybox:musl@sha256:03db190ed4c1ceb1c55d179a0940e2d71d42130636a780272629735893292223 AS check-fit_ctxs
WORKDIR /monorepo/.
COPY --parents tests/** ./
ARG SOURCE_DATE_EPOCH
ARG BAYT_CLAMP=1
RUN if [ "${BAYT_CLAMP:-1}" != 0 ]; then find /monorepo/. -exec touch -hd @${SOURCE_DATE_EPOCH:-0} {} + && touch -hd @${SOURCE_DATE_EPOCH:-0} /monorepo; fi
FROM scratch AS check-fit_srcs
COPY --from=check-fit_ctxs /monorepo /monorepo

